# ==============================================================================
# ENVIRONMENT & RUNTIME CONFIGURATION (PLACEHOLDERS ONLY - NO REAL SECRETS)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sofzenix_esign
DATABASE_USER=postgres
DATABASE_PASSWORD=placeholder_db_password

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/sofzenix_documents

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=placeholder_redis_password

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=sofzenix-esign-platform

# Object Storage Configuration (S3 / Blob)
STORAGE_PROVIDER=AWS_S3
STORAGE_BUCKET=sofzenix-document-vault-dev
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=placeholder_storage_access_key
STORAGE_SECRET_KEY=placeholder_storage_secret_key

# AI Workspace Configuration
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=OPENAI
AI_API_KEY=placeholder_ai_api_key

# Security & Token Authentication
JWT_SECRET=placeholder_jwt_secret_key_min_32_chars_length_required
JWT_EXPIRATION_MS=86400000

# Communication Gateway Keys (Placeholders)
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=placeholder_smtp_user
EMAIL_SMTP_PASSWORD=placeholder_smtp_password

WHATSAPP_API_KEY=placeholder_whatsapp_api_key
SMS_GATEWAY_API_KEY=placeholder_sms_api_key
